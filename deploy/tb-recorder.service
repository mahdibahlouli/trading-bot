# systemd unit for running the Hyperliquid recorder on an always-on Linux machine.
# Install:  sudo cp deploy/tb-recorder.service /etc/systemd/system/
#           (edit User and WorkingDirectory first)
#           sudo systemctl daemon-reload && sudo systemctl enable --now tb-recorder
# Logs:     journalctl -u tb-recorder -f
[Unit]
Description=Hyperliquid public-data recorder (tradingbot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/trading-bot
ExecStart=/home/YOUR_USER/trading-bot/.venv/bin/tb record hyperliquid
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
